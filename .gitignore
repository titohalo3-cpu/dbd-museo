# ============================================================
#  Modelos 3D y material pesado: NO se suben a GitHub, salvo los
#  .glb optimizados de models/ (WebP + meshopt, ~39 MB), que el
#  museo carga desde models/manifest.json.
# ============================================================
*.glb
*.gltf
*.bin
*.fbx
*.obj
*.blend
*.usdz
*.zip
*.7z
*.rar

source/
textures/
models/textures/
models/**/textures/

# Lo que SI se sube de models/: los .glb optimizados, manifest.json y README.txt
!models/*.glb

